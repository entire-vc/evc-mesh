# EVC Mesh — Environment Variables (development reference)
#
# NOTE: the API server does NOT load this file, or any .env file — it has no
# dotenv loader and reads the process environment only. Copying it to .env will
# not change how `go run ./cmd/api` behaves. Use it as the list of names and
# defaults, and export what you need.
#
# For a production deployment use deploy/docker/mesh/.env.prod.example, copied
# to deploy/docker/mesh/.env — that one IS read, by Docker Compose.
#
# Full reference with descriptions: docs/self-hosting.md#environment-variables-reference

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8005
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
# Gates GET /metrics behind `Authorization: Bearer <token>`. Empty leaves the
# endpoint open, which is what you want in local dev and for deployments that
# gate it at the network layer instead. MESH_METRICS_TOKEN_FILE names a file
# to read it from when the variable itself is empty — the production compose
# stack uses that form so it can generate the token for you.
MESH_METRICS_TOKEN=
MESH_METRICS_TOKEN_FILE=

# PostgreSQL (port 5437 per local-dev-ports.md)
DB_HOST=localhost
DB_PORT=5437
DB_USER=mesh
DB_PASSWORD=mesh
DB_NAME=mesh
DB_SSL_MODE=disable

# Redis (port 6383 per local-dev-ports.md)
REDIS_HOST=localhost
REDIS_PORT=6383
REDIS_PASSWORD=
REDIS_DB=0

# NATS JetStream
NATS_URL=nats://localhost:4223
# Monitoring HTTP endpoint (nats-server --http_port), matches
# NATS_MONITOR_PORT in deploy/docker/mesh/docker-compose.yml. Used only to
# discover the host's real storage limit if NATS_STREAM_MAX_BYTES turns out
# to be more than the host can give the MESH_EVENTS stream.
NATS_MONITOR_URL=http://localhost:8223
# MESH_EVENTS JetStream stream limits — defaults match the previous hardcoded
# values, so leaving these unset changes nothing. Lower NATS_STREAM_MAX_BYTES
# on a host with a small JetStream storage quota. Also feeds the bundled
# nats-server container's own `max_file_store` (see the `nats` service's
# `command:` in deploy/docker/mesh/docker-compose.yml — it writes its own
# config from this same env var at startup) so the two never silently
# diverge — previously the server autodetected its cap from host disk
# space instead.
NATS_STREAM_MAX_BYTES=10737418240
NATS_STREAM_MAX_AGE=720h
NATS_MAX_MSG_SIZE=262144
NATS_REPLICAS=1

# S3 / MinIO (ports 9002/9003 per local-dev-ports.md)
# The bucket holds task artifacts and workspace icons. It is created
# automatically at API startup — no manual `mc mb` needed.
S3_ENDPOINT=localhost:9002
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=mesh-artifacts
S3_REGION=us-east-1
S3_USE_SSL=false
# Optional: public base URL for ARTIFACT downloads (leave empty to use presigned
# S3 URLs). Not needed for workspace icons — the API streams those itself.
S3_PUBLIC_URL=

# Auth
JWT_SECRET=change-me-in-production
CASDOOR_ENDPOINT=
CASDOOR_CLIENT_ID=
AGENT_KEY_PREFIX=agk

# Self-registration. Closed by default: on a public address an open /register
# means anyone who finds the host can create an account. The first user on an
# empty database can always register regardless of this flag, so you can still
# create your own admin account normally — see
# docs/self-hosting.md#closing-registration. Add people afterwards by invite.
MESH_ALLOW_REGISTRATION=false

# First admin (optional) — a fresh install has no users and no default password.
# Either register at /register in the web UI, or set MESH_SEED_ADMIN=true to have
# the API create the first admin at startup. The seed runs only on a database
# with zero users. Leave MESH_ADMIN_PASSWORD empty to get a generated one,
# printed once in the API log. See docs/self-hosting.md#seeding-the-first-admin
MESH_SEED_ADMIN=false
MESH_ADMIN_EMAIL=
MESH_ADMIN_PASSWORD=
MESH_ADMIN_NAME=

# CORS (comma-separated origins, use * for development only)
MESH_CORS_ORIGINS=*

# Drop the Secure attribute from the refresh-token cookie. Only set this if you
# serve Mesh over plain HTTP on a trusted network — over HTTPS it puts a 7-day
# refresh token on the wire in cleartext. Leave unset for any internet-facing
# deployment; localhost development is detected automatically.
# MESH_COOKIE_INSECURE=true

# Rate limiting
MESH_RATE_LIMIT_ENABLED=true
MESH_RATE_LIMIT_AUTH_RPM=5
MESH_RATE_LIMIT_REFRESH_RPM=60
MESH_RATE_LIMIT_API_RPM=600

# Spark agent catalog integration (disabled by default)
MESH_SPARK_URL=
MESH_SPARK_ENABLED=false

# Telegram notification channel, for the whole instance (bots themselves are
# still configured per workspace on the Integrations page). Default: on.
# Set to false on a deployment that does not use Telegram at all — the channel
# then refuses to connect a bot and delivers nothing, instead of offering a
# setup flow that quietly goes nowhere. Existing integrations are not deleted.
MESH_TELEGRAM_ENABLED=true

# Public base URL of the web UI. Used to build workspace invite links; unset,
# invitees receive a link to their own machine. The API warns about this at
# startup.
MESH_BASE_URL=http://localhost:5173

# Outbound email for invites. With SMTP_HOST empty the API logs the invite link
# instead of sending it — the invite still works, you just deliver it yourself.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Encryption key for stored integration credentials (base64, 32 bytes:
# `openssl rand -base64 32`). Empty means those credentials are written to the
# database in PLAINTEXT — the API logs a warning at startup and exports
# mesh_integration_encryption_active=0.
MESH_INTEGRATION_ENCRYPTION_KEY=

# Set to true on any instance holding real credentials: the API then refuses to
# start, and refuses to store a credential, when the key above is missing or
# malformed — instead of silently downgrading to plaintext.
MESH_INTEGRATION_ENCRYPTION_REQUIRED=false

# HMAC secret for inbound GitHub webhooks. Empty disables signature validation.
MESH_GITHUB_WEBHOOK_SECRET=

# Token for the OUTBOUND GitHub call the done-evidence gate makes to verify a
# linked PR's live merge status when the cached status says "not merged"
# (move_task->done). Empty disables the live check — the gate falls back to
# the cached vcs_links.status only. May also be set via MESH_GITHUB_TOKEN_FILE.
MESH_GITHUB_TOKEN=

# Semantic memory recall. With EMBEDDING_PROVIDER=none the API runs a no-op
# embedder and recall is keyword-only. Options: none | ollama | openai
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
EMBEDDING_ENDPOINT=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=0
# Caps concurrent embed calls (write + recall + backfill share this bound). 0 =
# unbounded — only safe against a horizontally-scaled/hosted embedding API. A
# self-hosted CPU-bound embedder gets SLOWER past its core count when flooded
# (measured: +60% throughput after capping ~40 in-flight down to 4, #9fe5bb71).
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CONCURRENCY=4
EMBEDDING_HTTP_TIMEOUT_SECS=30

# Memory recall scoring. Defaults are the tuned values.
MEMORY_RECALL_HALF_LIFE_DAYS=30
MEMORY_RECALL_RRF_VECTOR_WEIGHT=0.7
MEMORY_RECALL_RRF_TEXT_WEIGHT=0.3

# Browser push notifications. All three must be set or push stays disabled.
# MESH_VAPID_SUBJECT defaults to this project's own contact address — change it.
MESH_VAPID_PUBLIC_KEY=
MESH_VAPID_PRIVATE_KEY=
MESH_VAPID_SUBJECT=

# Team Relay artifact transport (disabled by default).
MESH_TEAMRELAY_TRANSPORT_ENABLED=false
MESH_TEAMRELAY_RELAY_URL=
MESH_TEAMRELAY_WEB_BASE_URL=

# MCP server. The binary lives in its OWN repository (entire-vc/evc-mesh-mcp);
# nothing in this repo reads these variables. They are listed here because the
# self-hosted stack (deploy/docker/mesh) runs that binary next to the API and
# passes them through. This repo used to build a duplicate copy of the same
# server under cmd/mcp; it had drifted 12 tools behind and was deleted — Mesh
# #e85e4e05.
# MESH_MCP_PUBLIC_URL is only needed when a reverse proxy serves MCP under a
# path prefix — see docs/agent-onboarding.md.
MESH_MCP_TRANSPORT=stdio
MESH_API_URL=http://localhost:8005
MESH_AGENT_KEY=
MESH_MCP_HOST=0.0.0.0
MESH_MCP_PORT=8081
MESH_MCP_PROFILE=full
MESH_MCP_PUBLIC_URL=

# Import/migration escape hatch: allows creating a task directly in a
# review-category status. Leave off for normal operation.
MESH_ALLOW_REVIEW_AT_CREATE=false
