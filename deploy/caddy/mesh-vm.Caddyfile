{
	auto_https off

	# --- Client IP through the hel01 hop (Mesh #71f2ca77, #5d759aad) ---------
	# LOAD-BEARING FOR RATE LIMITING. Removing this silently turns per-IP
	# limiting on /api/v1/auth/login into ONE shared bucket for the entire
	# internet -- and nothing errors when it happens.
	#
	# Topology: hel01 (public, terminates TLS) -> mesh-vm:80 -> 127.0.0.1:8005.
	# hel01 has no trusted_proxies of its own, which is correct: it is the trust
	# boundary, so it OVERWRITES whatever X-Forwarded-For a client sent with the
	# real peer address. The true client IP therefore does arrive here.
	#
	# Without the line below, this hop then does the same thing to hel01 -- it
	# does not trust the incoming XFF and overwrites it with its peer, 10.10.10.1.
	# Measured on prod: POST /api/v1/auth/login with a spoofed
	# X-Forwarded-For: 203.0.113.77 produced NO ratelimit:203.0.113.77:* key in
	# Redis; the request landed in ratelimit:10.10.10.1:* -- i.e. every external
	# client shared one 5 RPM bucket. That is not a weak limiter, it is a DoS
	# primitive: one machine looping on /auth/login locks every real user,
	# the agent fleet and CI out of login.
	#
	# Scope is deliberately ONE host, not the /24. hel01 is 10.10.10.1 on vmbr1
	# (mesh-vm is .10; billing .20, spark .30, argus .60 are peers on the same
	# bridge). Widening this to 10.10.10.0/24 or 10.0.0.0/8 would let a
	# neighbouring guest forge client IPs. Spoofing from the internet is not
	# possible while hel01 keeps resetting XFF at the perimeter -- that property
	# is what makes trusting this one hop safe, so do not add trusted_proxies to
	# hel01 without revisiting this.
	servers {
		trusted_proxies static 10.10.10.1/32
	}
}
:80 {
	# --- Compression (Mesh #32f4c087, 2026-08-20) ---------------------------
	# Nothing was compressed before this: the board shipped ~2.5 MB raw on every
	# load (1.5 MB JS + 91 KB CSS + ~917 KB of task JSON).
	#
	# THE PATH EXCLUSION BELOW IS LOAD-BEARING. Do not "simplify" it away.
	# Measured live on prod 2026-08-20 18:55 UTC: a site-wide `encode` — even
	# with a response `match` block that deliberately omitted text/event-stream —
	# still swallowed the SSE response headers at
	# /api/v1/agents/me/events/stream. encode has to buffer the response to
	# decide whether to compress it, and an idle SSE stream never produces
	# enough bytes for that decision, so the client got NOTHING for 8s+ while
	# the app itself (127.0.0.1:8005) was answering instantly. Filtering on the
	# response Content-Type is too late; the request path is the only guard that
	# runs early enough. Rolled back within 3 minutes and re-applied in this
	# narrowed form.
	#
	# /api/v1/agents/me/events/stream is the only streaming handler in the API
	# (verified: it is the sole caller of Response().Flush() in internal/handler).
	# /mcp/* is the MCP SSE transport, /ws is a websocket upgrade, /s3/* is
	# binary object storage with range requests — none of them want an encoder.
	@compressible {
		not path /api/v1/agents/me/events/stream
		not path /mcp/*
		not path /ws
		not path /s3/*
	}
	encode @compressible zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/javascript*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
			header Content-Type application/wasm*
		}
	}

	# --- MIME-sniffing (Mesh #e8c44540, 2026-08-21) --------------------------
	# Site-level on purpose: it must also cover /s3/*, which serves objects
	# uploaded by users. Without it a browser is free to disregard the
	# Content-Type MinIO reports and execute an upload as script or stylesheet
	# if the bytes look like one -- the one surface here where the content is
	# not written by us.
	#
	# Chosen as the header this repo's Caddy deploy pipeline was first proven
	# with end to end: the two prior deploys were a no-op and a change with no
	# externally visible effect, so "a config edit reaches prod" had never
	# actually been observed. This one is visible in `curl -sI`.
	header X-Content-Type-Options "nosniff"

	handle /api/* {
		reverse_proxy 127.0.0.1:8005
	}
	handle /ws {
		reverse_proxy 127.0.0.1:8005
	}
	handle /health {
		reverse_proxy 127.0.0.1:8005
	}
	handle_path /mcp/* {
		# Host is rewritten to a loopback value on purpose. mcp-go >= v0.57.0
		# applies DNS-rebinding protection: a connection whose LOCAL address is
		# loopback (which this one is -- Caddy dials 127.0.0.1:8081) but whose
		# Host header is not, gets 403 "invalid Host header". That guard exists
		# for an MCP server a browser can reach at localhost; here the caller is
		# already authenticated by agent key, and the only thing upstream of us
		# is this proxy. Removing this line makes /mcp/sse 403 for every client.
		# The server does not use Host for anything: message endpoints are
		# advertised from MESH_MCP_PUBLIC_URL (.env.prod), not derived from Host.
		reverse_proxy 127.0.0.1:8081 {
			header_up Host localhost
		}
	}
	handle_path /s3/* {
		reverse_proxy 127.0.0.1:9000 {
			header_up Host 127.0.0.1:9000
		}
	}
	handle /webhooks/* {
		reverse_proxy 127.0.0.1:8005
	}

	# Vite writes a content hash into every filename under /assets/, so a given
	# URL's bytes can never change -> cache forever. Kept as its own handle (no
	# try_files) so a request for a DELETED asset hash 404s instead of falling
	# back to index.html and getting an immutable HTML page cached in its place.
	handle /assets/* {
		root * /opt/evc-mesh/web/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /opt/evc-mesh/web/dist
		# index.html / sw.js / manifest / icons are unhashed: they MUST revalidate,
		# or a deploy leaves clients on a shell pointing at asset hashes that no
		# longer exist. etag/last-modified make the revalidation a cheap 304.
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Prometheus metrics endpoint — accessible via hel01 DNAT from tw-mon only
:9105 {
	handle /metrics {
		reverse_proxy 127.0.0.1:8005
	}
	handle /mcp-metrics {
		rewrite * /metrics
		reverse_proxy 127.0.0.1:8081
	}
	respond 404
}
