COMPOSE_PROJECT_NAME=evc-mesh

# Required — set before first deploy
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# First admin — created only on a database with zero users, only at API startup.
# Leave MESH_ADMIN_PASSWORD empty and a strong password is generated and printed
# once in the API log ("[bootstrap] Generated password: ..."). Set it explicitly
# if you want to choose your own. See docs/self-hosting.md#seeding-the-first-admin
MESH_SEED_ADMIN=true
MESH_ADMIN_EMAIL=admin@localhost
MESH_ADMIN_PASSWORD=
MESH_ADMIN_NAME=Admin

# Optional
API_PORT=8005
HTTP_PORT=80
MCP_PORT=8081
MESH_CORS_ORIGINS=https://your-domain.com
GRAFANA_PASSWORD=admin
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Set to false to close self-registration once your first admin exists.
# The first user on an empty database can always register regardless.
MESH_ALLOW_REGISTRATION=true

# Public base URL of the web UI — used to build workspace invite links.
MESH_BASE_URL=https://your-domain.com

# Outbound email for workspace invites. Leave SMTP_HOST empty and the API
# logs the invite link instead of sending it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com

# Rate limits (requests per minute). Auth is counted per IP — raise it if
# your whole team shares one NAT'd egress IP.
MESH_RATE_LIMIT_AUTH_RPM=5
MESH_RATE_LIMIT_REFRESH_RPM=60
MESH_RATE_LIMIT_API_RPM=600
