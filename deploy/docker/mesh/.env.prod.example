# EVC Mesh — production environment.
#
# Copy this file to `.env` IN THIS DIRECTORY:
#
#     cp .env.prod.example .env
#
# The name matters. Docker Compose auto-loads `.env` from the directory holding
# the compose file and nothing else — not `.env.prod`, not the repo-root `.env`.
# A misnamed file fails as "required variable POSTGRES_PASSWORD is missing a
# value", which reads like a missing variable rather than an unread file.
# Pass it explicitly on every command:
#
#     docker compose -f docker-compose.prod.yml --env-file .env up -d --build
#
# Reference: docs/self-hosting.md#production-deployment

COMPOSE_PROJECT_NAME=evc-mesh

# Required — set before first deploy.
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY configure both the bundled MinIO and the
# API's S3 client. The bucket holding task artifacts and workspace icons is
# created automatically at API startup — nothing to set up by hand.
# See docs/self-hosting.md#file-storage
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
GRAFANA_PASSWORD=

# Optional — the stack generates these if you leave them unset.
# Gates GET /metrics. Left empty, the stack generates one on first start into
# volumes/secrets/metrics_token and hands that same file to both the API and
# Prometheus, so scraping works with nothing to configure. Set it here to
# choose the value yourself (`openssl rand -hex 32`) — it is written to the
# same file and takes precedence. See docs/self-hosting.md#security-checklist
MESH_METRICS_TOKEN=

# First admin — created only on a database with zero users, only at API startup.
# Leave MESH_ADMIN_PASSWORD empty and a strong password is generated and printed
# once in the API log ("[bootstrap] Generated password: ..."). Set it explicitly
# if you want to choose your own. See docs/self-hosting.md#seeding-the-first-admin
MESH_SEED_ADMIN=true
MESH_ADMIN_EMAIL=admin@localhost
MESH_ADMIN_PASSWORD=
MESH_ADMIN_NAME=Admin

# Optional
API_PORT=8005
HTTP_PORT=80
MCP_PORT=8081
MESH_CORS_ORIGINS=https://your-domain.com
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Self-registration. Closed by default: on a public address an open /register
# means anyone who finds the host can create an account, and the cross-workspace
# user lookup lets them find your admins. The first user on an empty database
# can always register regardless of this flag, so your own admin account is
# unaffected. See docs/self-hosting.md#closing-registration
MESH_ALLOW_REGISTRATION=false

# Public base URL of the web UI — used to build workspace invite links. Unset,
# it falls back to http://localhost:5173 and invitees get a link to their own
# machine. The API warns about this at startup.
MESH_BASE_URL=https://your-domain.com

# Public URL artifact/icon download links are rewritten to. Unset, the API
# hands back presigned URLs pointing at the internal Docker hostname
# (minio:9000), which browsers can't resolve — every download link 404s/401s.
# nginx.conf proxies /s3/ straight through to MinIO, so set this to your
# domain plus that path; the presigned signature survives the rewrite.
S3_PUBLIC_URL=https://your-domain.com/s3

# Encryption key for stored integration credentials (base64, 32 bytes:
# `openssl rand -base64 32`). Empty means those credentials are written to the
# database in PLAINTEXT.
MESH_INTEGRATION_ENCRYPTION_KEY=

# Shared secret for inbound GitHub webhooks. Empty means signatures are not
# verified — anyone who learns the URL can post events to your instance.
MESH_GITHUB_WEBHOOK_SECRET=

# Only needed when a reverse proxy serves MCP under a path prefix, e.g.
# https://your-domain.com/mcp. Leave empty when MCP is reached directly on
# MCP_PORT or on its own hostname. See docs/agent-onboarding.md
MESH_MCP_PUBLIC_URL=

# Outbound email for workspace invites. Leave SMTP_HOST empty and the API
# logs the invite link instead of sending it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com

# Rate limits (requests per minute). Auth is counted per IP — raise it if
# your whole team shares one NAT'd egress IP.
MESH_RATE_LIMIT_AUTH_RPM=5
MESH_RATE_LIMIT_REFRESH_RPM=60
MESH_RATE_LIMIT_API_RPM=600
