# EVC Mesh — production environment.
#
# Copy this file to `.env` IN THIS DIRECTORY:
#
#     cp .env.prod.example .env
#
# The name matters. Docker Compose auto-loads `.env` from the directory holding
# the compose file and nothing else — not `.env.prod`, not the repo-root `.env`.
# A misnamed file fails as "required variable POSTGRES_PASSWORD is missing a
# value", which reads like a missing variable rather than an unread file.
# Pass it explicitly on every command:
#
#     docker compose -f docker-compose.prod.yml --env-file .env up -d --build
#
# Reference: docs/self-hosting.md#production-deployment

COMPOSE_PROJECT_NAME=evc-mesh

# Required — set before first deploy.
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY configure both the bundled MinIO and the
# API's S3 client. The bucket holding task artifacts and workspace icons is
# created automatically at API startup — nothing to set up by hand.
# See docs/self-hosting.md#file-storage
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
GRAFANA_PASSWORD=

# Optional — the stack generates these if you leave them unset.
# Gates GET /metrics. Left empty, the stack generates one on first start into
# volumes/secrets/metrics_token and hands that same file to both the API and
# Prometheus, so scraping works with nothing to configure. Set it here to
# choose the value yourself (`openssl rand -hex 32`) — it is written to the
# same file and takes precedence. See docs/self-hosting.md#security-checklist
MESH_METRICS_TOKEN=

# First admin — created only on a database with zero users, only at API startup.
# Leave MESH_ADMIN_PASSWORD empty and a strong password is generated and printed
# once in the API log ("[bootstrap] Generated password: ..."). Set it explicitly
# if you want to choose your own. See docs/self-hosting.md#seeding-the-first-admin
MESH_SEED_ADMIN=true
MESH_ADMIN_EMAIL=admin@localhost
MESH_ADMIN_PASSWORD=
MESH_ADMIN_NAME=Admin

# Optional
API_PORT=8005
HTTP_PORT=80
MCP_PORT=8081
MESH_CORS_ORIGINS=https://your-domain.com
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Self-registration. Closed by default: on a public address an open /register
# means anyone who finds the host can create an account, and the cross-workspace
# user lookup lets them find your admins. The first user on an empty database
# can always register regardless of this flag, so your own admin account is
# unaffected. See docs/self-hosting.md#closing-registration
MESH_ALLOW_REGISTRATION=false

# Public base URL of the web UI — used to build workspace invite links. Unset,
# it falls back to http://localhost:5173 and invitees get a link to their own
# machine. The API warns about this at startup.
MESH_BASE_URL=https://your-domain.com

# Public base URL that artifact download links are rewritten to. Unset, the API
# hands back presigned URLs built from S3_ENDPOINT — under compose that is the
# internal hostname minio:9000, which a browser cannot resolve, so every
# artifact download fails to connect. nginx.conf proxies /s3/ through to MinIO
# without overriding the Host header, so the presigned signature still
# validates: point this at your domain plus that path. Workspace icons do NOT
# need it — the API streams those bytes itself.
# See docs/self-hosting.md#how-files-are-served-back
S3_PUBLIC_URL=https://your-domain.com/s3

# Encryption key for stored integration credentials (base64, 32 bytes:
# `openssl rand -base64 32`). Empty means those credentials are written to the
# database in PLAINTEXT.
MESH_INTEGRATION_ENCRYPTION_KEY=

# Refuse to start, and refuse to store a credential, when the key above is
# missing or malformed. Recommended for any instance holding real credentials:
# without it a mistyped key degrades to plaintext storage and nothing fails.
MESH_INTEGRATION_ENCRYPTION_REQUIRED=true

# Shared secret for inbound GitHub webhooks. Empty means signatures are not
# verified — anyone who learns the URL can post events to your instance.
MESH_GITHUB_WEBHOOK_SECRET=

# Token for the done-evidence gate's live GitHub PR-status check
# (move_task->done). Needs read access to Pull requests on the repos you
# link. Empty disables the live check — the gate falls back to the cached
# vcs_links.status only, which can go stale if a webhook delivery is missed.
MESH_GITHUB_TOKEN=

# Web Push (browser notifications). Leave the keypair empty and browser push
# stays disabled — the API says so once at startup and carries on. Generate a
# P-256/base64url VAPID keypair with `npx web-push generate-vapid-keys`.
# MESH_VAPID_SUBJECT is the VAPID JWT "sub" claim — a mailto: address or URL.
# Set it too: push services reject a VAPID token without one.
# See docs/self-hosting.md#browser-push-notifications
MESH_VAPID_PUBLIC_KEY=
MESH_VAPID_PRIVATE_KEY=
MESH_VAPID_SUBJECT=

# Left empty on purpose: nginx.conf proxies MCP under /mcp on the same origin
# as the web UI, and docker-compose.prod.yml defaults this to
# "${MESH_BASE_URL}/mcp" for you — set MESH_BASE_URL above and this follows
# automatically. Set it explicitly here only to override that default, e.g.
# serving MCP on its own hostname or port instead. See docs/agent-onboarding.md
MESH_MCP_PUBLIC_URL=

# Outbound email for workspace invites. Leave SMTP_HOST empty and the API
# logs the invite link instead of sending it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com

# Rate limits (requests per minute). Auth is counted per IP — raise it if
# your whole team shares one NAT'd egress IP.
MESH_RATE_LIMIT_AUTH_RPM=5
MESH_RATE_LIMIT_REFRESH_RPM=60
MESH_RATE_LIMIT_API_RPM=600

# NATS JetStream MESH_EVENTS stream limits. Defaults below match the
# previous hardcoded values — leaving these unset changes nothing. Lower
# NATS_STREAM_MAX_BYTES if this host's JetStream storage quota is under
# 10 GB; the API detects a too-large request at startup, retries once with
# the host's real reported limit, and only fails to boot if even that isn't
# enough (see internal/eventbus/nats.go ensureStream()). NATS_MONITOR_URL is
# nats-server's monitoring HTTP endpoint (its --http_port, fixed at 8222 for
# the bundled nats service) — needed for that retry to discover the real
# limit; leave it as-is unless you point NATS_URL at a different server.
# NATS_STREAM_MAX_BYTES also feeds the bundled nats-server container's own
# JetStream `max_file_store` (deploy/docker/mesh/nats-server.conf) — the
# server used to autodetect that cap from host disk space instead, which
# is how it silently diverged from the API's own configured stream size.
NATS_MONITOR_URL=http://nats:8222
NATS_STREAM_MAX_BYTES=10737418240
NATS_STREAM_MAX_AGE=720h
NATS_MAX_MSG_SIZE=262144
NATS_REPLICAS=1
