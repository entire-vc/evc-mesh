# Nginx image bundling the compiled frontend static files.
# Built as part of docker-compose.prod.yml.

# Stage 1: Build frontend
FROM node:20-alpine AS web-builder
RUN corepack enable
WORKDIR /app
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
# pnpm-workspace.yaml declares patchedDependencies -> patches/@milkdown__ctx@7.22.1.patch.
# --frozen-lockfile applies patches during install, so the patch file has to be here
# BEFORE the install, not with the rest of web/ after it.
COPY web/patches/ ./patches/
RUN pnpm install --frozen-lockfile
COPY web/ .
# The app reads the theme SDK's source (tsconfig paths and the vite alias point at ../packages/mesh-theme-sdk/src).
COPY packages/mesh-theme-sdk/src/ /packages/mesh-theme-sdk/src/
# web's typecheck also covers the contract-test harness the app's tests import (builder stage only).
COPY packages/mesh-theme-sdk/testing/ /packages/mesh-theme-sdk/testing/
# web/src/lib/__tests__/extension-capabilities-i18n.test.ts imports the extension manifest
# schema from outside web/ (../../../../internal/... from /app/src/lib/__tests__ = /internal/...);
# tsc -b type-checks tests, so the file has to be visible here.
COPY internal/extensions/schema/manifest.v1.json /internal/extensions/schema/manifest.v1.json
RUN pnpm build

# Stage 2: Nginx with static files
FROM nginx:alpine
COPY --from=web-builder /app/dist /srv/web
COPY deploy/docker/mesh/nginx.conf /etc/nginx/conf.d/default.conf
# Trusted-hop list for the realip module (see nginx.conf). Rendered on every
# start from MESH_TRUSTED_PROXIES, and once here so the image already ships the
# file nginx.conf includes (private ranges only). No `nginx -t` at build: the
# config's literal upstreams (api, minio) only resolve inside the compose network.
COPY deploy/docker/mesh/25-mesh-trusted-proxies.sh /docker-entrypoint.d/25-mesh-trusted-proxies.sh
RUN chmod 755 /docker-entrypoint.d/25-mesh-trusted-proxies.sh \
    && /docker-entrypoint.d/25-mesh-trusted-proxies.sh
EXPOSE 80
