{
  "schema": 1,
  "id": "reference-ext",
  "name": "Reference extension",
  "version": "0.1.0",
  "kind": "plugin",
  "runtime": "external",
  "mesh_api": ">=1 <2",
  "publisher": "example",
  "description": "Reference external extension: install handshake, token delivery, signed events, iframe screens",
  "category": "development",
  "levels": {
    "instance": false,
    "workspace": true,
    "project": true
  },
  "settings": {
    "workspace": {
      "type": "object",
      "properties": {
        "service_url": {
          "type": "string",
          "format": "uri",
          "title": "Service address"
        }
      },
      "required": [
        "service_url"
      ]
    }
  },
  "capabilities": {
    "api": [
      "tasks:read",
      "comments:write"
    ],
    "events": [
      "task.created",
      "task.moved",
      "comment.created"
    ],
    "network": {
      "allowed_domains": [
        "{settings.service_url}"
      ]
    },
    "ui": [
      "sidebar.item",
      "task.panel",
      "project.view",
      "dashboard.widget"
    ]
  },
  "external": {
    "base_url_setting": "service_url",
    "health_path": "/healthz",
    "install_path": "/mesh/install",
    "events_path": "/mesh/events",
    "token_path": "/mesh/token",
    "ui": {
      "sidebar.item": {
        "path": "/mesh/ui/hello",
        "title": "Reference"
      },
      "task.panel": {
        "path": "/mesh/ui/task",
        "title": "Reference"
      },
      "project.view": {
        "path": "/mesh/ui/project",
        "title": "Reference"
      }
    }
  },
  "project_view": {
    "icon": "Puzzle",
    "title": "Reference"
  },
  "widgets": [
    {
      "id": "status",
      "title": "Reference widget",
      "title_i18n": {
        "ru": "Эталонный виджет"
      },
      "description": "Protocol v2 reference: theme, settings, visibility, refresh and mesh.open.",
      "category": "integrations",
      "size": {
        "default": {
          "w": 4,
          "h": 3
        },
        "min": {
          "w": 3,
          "h": 2
        },
        "max": {
          "w": 12,
          "h": 6
        }
      },
      "settings": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "title": "Label",
            "maxLength": 40
          }
        }
      },
      "scope": "workspace",
      "render": {
        "frame": {
          "path": "/mesh/ui/widget",
          "min_refresh_s": 30
        }
      }
    }
  ]
}
