{
  "schema": 1,
  "id": "agent-chat",
  "name": "Chat with Agent",
  "version": "0.1.0",
  "kind": "plugin",
  "runtime": "builtin",
  "mesh_api": ">=1 <2",
  "publisher": "entire-vc",
  "description": "Chat with Agent: private per-user threads with a project agent served by a workspace runner",
  "category": "agents",
  "tags": [
    "agents",
    "chat"
  ],
  "license": "Apache-2.0",
  "repository": "https://github.com/entire-vc/evc-mesh",
  "levels": {
    "instance": false,
    "workspace": true,
    "project": true
  },
  "requires": [
    "runner"
  ],
  "settings": {
    "workspace": {
      "type": "object",
      "properties": {
        "history_retention_days": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "title": "Keep history, days (0 = forever)",
          "title_i18n": { "ru": "Хранить историю, дней (0 — бессрочно)" }
        },
        "max_attachment_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25,
          "default": 25,
          "title": "Attachment limit, MB",
          "title_i18n": { "ru": "Лимит вложения, МБ" }
        },
        "session_idle_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240,
          "default": 10,
          "title": "Stop an idle chat session after, minutes",
          "title_i18n": { "ru": "Остановить сессию чата после простоя, минут" }
        },
        "offline_expiry_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 720,
          "default": 24,
          "title": "Expire a message the agent never picked up after, hours",
          "title_i18n": { "ru": "Считать сообщение недоставленным, если агент не взял его за, часов" }
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "agents": {
          "type": "array",
          "items": { "type": "string" },
          "x-widget": "agent-picker",
          "title": "Agents in the chat",
          "title_i18n": { "ru": "Агенты в чате" }
        },
        "allowed_roles": {
          "type": "array",
          "items": { "enum": ["admin", "member", "viewer"] },
          "default": ["admin", "member"],
          "title": "Roles that may chat",
          "title_i18n": { "ru": "Роли, которым доступен чат" }
        }
      },
      "required": [
        "agents"
      ],
      "additionalProperties": false
    }
  },
  "capabilities": {
    "api": [
      "agents:read",
      "projects:read"
    ],
    "events": [],
    "webhooks_in": [],
    "ui": [
      "project.settings",
      "workspace.settings"
    ],
    "secrets": []
  }
}
