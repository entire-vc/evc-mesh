{
  "schema": 1,
  "id": "gitlab",
  "name": "GitLab",
  "version": "1.1.0",
  "kind": "integration",
  "runtime": "builtin",
  "mesh_api": ">=1 <2",
  "publisher": "entire-vc",
  "description": "Links GitLab merge requests to tasks: webhook, MR and pipeline status",
  "category": "development",
  "tags": [
    "vcs"
  ],
  "license": "Apache-2.0",
  "repository": "https://github.com/entire-vc/evc-mesh",
  "levels": {
    "instance": true,
    "workspace": true,
    "project": true
  },
  "settings": {
    "instance": {
      "$ref": "#/schemas/connection"
    },
    "workspace": {
      "$ref": "#/schemas/connection"
    },
    "project": {
      "type": "object",
      "properties": {
        "repo_path": {
          "type": "string",
          "title": "Project path (group/project)",
          "title_i18n": { "ru": "Путь проекта (group/project)" }
        }
      },
      "required": [
        "repo_path"
      ]
    }
  },
  "schemas": {
    "connection": {
      "type": "object",
      "properties": {
        "base_url": {
          "type": "string",
          "format": "uri",
          "title": "GitLab URL",
          "title_i18n": { "ru": "URL GitLab" }
        },
        "token": {
          "type": "string",
          "title": "Token",
          "title_i18n": { "ru": "Токен" },
          "x-secret": true
        },
        "webhook_secret": {
          "type": "string",
          "title": "Webhook secret",
          "title_i18n": { "ru": "Секрет вебхука" },
          "x-secret": true
        }
      }
    }
  },
  "capabilities": {
    "api": [
      "tasks:read",
      "tasks:write",
      "vcs_links:write"
    ],
    "events": [],
    "webhooks_in": [
      "gitlab"
    ],
    "network": {
      "allowed_domains": [
        "{settings.base_url}"
      ],
      "reasoning": "MR and pipeline status check via the GitLab instance API"
    },
    "ui": [
      "task.panel",
      "task.badge",
      "task.actions",
      "dashboard.widget"
    ],
    "secrets": [
      "token",
      "webhook_secret"
    ]
  },
  "widgets": [
    {
      "id": "failed-pipelines",
      "title": "Failed pipelines",
      "title_i18n": { "ru": "Упавшие пайплайны" },
      "description": "Pipelines of my merge requests that failed in the last 24 h",
      "description_i18n": { "ru": "Пайплайны моих MR, упавшие за последние 24 часа" },
      "category": "development",
      "size": {
        "default": { "w": 6, "h": 4 },
        "min": { "w": 3, "h": 2 },
        "max": { "w": 12, "h": 8 }
      },
      "settings": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "title": "Project",
            "title_i18n": { "ru": "Проект" },
            "x-widget": "project-picker"
          }
        }
      },
      "scope": "project",
      "render": { "builtin": "GitlabFailedPipelinesWidget" }
    }
  ]
}
