{
  "schema": 1,
  "id": "hello",
  "name": "Hello",
  "version": "0.1.0",
  "kind": "plugin",
  "runtime": "external",
  "mesh_api": ">=1",
  "publisher": "example",
  "description": "Минимальный пример внешнего расширения",
  "category": "development",
  "levels": {
    "instance": false,
    "workspace": true,
    "project": false
  },
  "capabilities": {
    "api": [
      "tasks:read"
    ],
    "events": [
      "task.created"
    ],
    "ui": [
      "task.badge"
    ]
  },
  "external": {
    "base_url_setting": "hello_url",
    "health_path": "/healthz",
    "install_path": "/mesh/install",
    "events_path": "/mesh/events"
  },
  "settings": {
    "workspace": {
      "type": "object",
      "properties": {
        "hello_url": {
          "type": "string",
          "format": "uri",
          "title": "Адрес сервиса"
        }
      },
      "required": [
        "hello_url"
      ]
    }
  }
}
