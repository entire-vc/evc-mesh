{
  "schema": 1,
  "id": "spark",
  "name": "Spark",
  "version": "1.0.0",
  "kind": "integration",
  "runtime": "builtin",
  "mesh_api": ">=1 <2",
  "publisher": "entire-vc",
  "description": "Spark asset catalog: search, popular assets, installing agents into the workspace",
  "category": "development",
  "tags": [
    "catalog"
  ],
  "license": "Apache-2.0",
  "repository": "https://github.com/entire-vc/evc-spark-mcp",
  "levels": {
    "instance": true,
    "workspace": true,
    "project": false
  },
  "settings": {
    "instance": {
      "$ref": "#/schemas/connection"
    },
    "workspace": {
      "$ref": "#/schemas/connection"
    }
  },
  "schemas": {
    "connection": {
      "type": "object",
      "properties": {
        "spark_url": {
          "type": "string",
          "format": "uri",
          "title": "Spark catalog URL",
          "title_i18n": { "ru": "Адрес каталога Spark" }
        },
        "catalog_public_key": {
          "type": "string",
          "title": "Extension catalog public key (ed25519, base64)",
          "title_i18n": { "ru": "Публичный ключ каталога расширений (ed25519, base64)" },
          "description": "Empty — the built-in Spark key is used. Replace it if the catalog key has changed.",
          "description_i18n": { "ru": "Пусто — используется зашитый ключ Spark. Заменить, если ключ каталога сменили." }
        },
        "catalog_install_counter": {
          "type": "boolean",
          "default": true,
          "title": "Report extension installs to Spark (anonymous counter)",
          "title_i18n": { "ru": "Сообщать Spark об установках расширений (анонимный счётчик)" }
        }
      },
      "required": [
        "spark_url"
      ]
    }
  },
  "capabilities": {
    "api": [
      "agents:write"
    ],
    "events": [],
    "webhooks_in": [],
    "ui": [],
    "secrets": []
  }
}
