{
  "schema": 1,
  "id": "board-studio",
  "name": "Prototypes",
  "version": "1.0.0",
  "kind": "theme",
  "runtime": "builtin",
  "mesh_api": ">=1 <2",
  "publisher": "entire-vc",
  "description": "Prototypes colours and type: the board as status bands with a person filter and a new card; the dashboard on its own grid with a due-this-week widget",
  "category": "appearance",
  "tags": ["board", "dashboard", "layout"],
  "license": "Apache-2.0",
  "levels": { "instance": true, "workspace": true, "project": false },
  "capabilities": {},
  "settings": {
    "workspace": { "$ref": "#/schemas/workspace" },
    "instance": { "$ref": "#/schemas/instance" }
  },
  "schemas": {
    "instance": {
      "type": "object",
      "properties": {
        "accent": { "type": "string", "title": "Accent colour", "x-widget": "color", "x-token": "primary" }
      }
    },
    "workspace": {
      "type": "object",
      "properties": {
        "accent": { "type": "string", "title": "Accent colour", "x-widget": "color", "x-token": "primary" },
        "cover_style": {
          "type": "string",
          "title": "Card cover",
          "description": "The priority colour on the left edge of a card",
          "enum": ["block", "strip", "none"],
          "default": "block",
          "x-widget": "layout-picker",
          "x-options": { "block": "Wide block", "strip": "Thin strip", "none": "No cover" }
        },
        "show_wip": { "type": "boolean", "title": "Show work-in-progress limits on bands", "default": true },
        "focus_horizon_days": { "type": "integer", "title": "Days ahead in the due-this-week widget", "minimum": 1, "maximum": 30, "default": 7 },
        "card_fields": { "type": "array", "title": "Card fields", "items": { "type": "string" }, "x-widget": "field-picker" },
        "widgets": { "type": "array", "title": "Dashboard widgets", "items": { "type": "string" }, "x-widget": "widget-picker" }
      }
    }
  },
  "theme": {
    "tokens_contract": "1",
    "modes": ["light", "dark"],
    "tokens": {
      "light": {
        "background": "240 11.1% 98.2%",
        "foreground": "222.9 14.9% 9.2%",
        "card": "0 0% 100%",
        "card-foreground": "222.9 14.9% 9.2%",
        "popover": "0 0% 100%",
        "popover-foreground": "222.9 14.9% 9.2%",
        "primary": "20.1 100% 56.1%",
        "primary-foreground": "224 21.7% 13.5%",
        "secondary": "220 14% 96%",
        "secondary-foreground": "218.6 10.8% 25.5%",
        "muted": "220 14% 96%",
        "muted-foreground": "218.8 9.1% 36.7%",
        "accent": "22.7 100% 91.2%",
        "accent-foreground": "224 21.7% 13.5%",
        "destructive": "356 65.1% 49.4%",
        "destructive-foreground": "0 0% 100%",
        "success": "139.3 69.8% 40.2%",
        "success-foreground": "224 21.7% 13.5%",
        "warning": "42.4 100% 45.5%",
        "warning-foreground": "224 21.7% 13.5%",
        "info": "201 67% 51%",
        "info-foreground": "224 21.7% 13.5%",
        "border": "220 11.5% 89.8%",
        "input": "220 10% 82%",
        "ring": "20.1 100% 56.1%",
        "sidebar-background": "225.9 36.2% 9.2%",
        "sidebar-foreground": "220 14% 96%",
        "sidebar-primary": "20.1 100% 56.1%",
        "sidebar-primary-foreground": "224 21.7% 13.5%",
        "sidebar-accent": "223.6 13.6% 15.9%",
        "sidebar-accent-foreground": "220 14% 96%",
        "sidebar-border": "223.6 13.6% 15.9%",
        "radius": "0.5rem",
        "font-sans": "\"SB Sans Display\", \"Inter\", system-ui, sans-serif"
      },
      "dark": {
        "background": "225.9 36.2% 9.2%",
        "foreground": "220 14% 96%",
        "card": "224 21.7% 13.5%",
        "card-foreground": "220 14% 96%",
        "popover": "224 21.7% 13.5%",
        "popover-foreground": "220 14% 96%",
        "primary": "20.1 100% 56.1%",
        "primary-foreground": "225.9 36.2% 9.2%",
        "secondary": "223.6 13.6% 15.9%",
        "secondary-foreground": "220 14% 96%",
        "muted": "223.6 13.6% 15.9%",
        "muted-foreground": "218.6 8.5% 67.8%",
        "accent": "218.6 10.8% 25.5%",
        "accent-foreground": "220 14% 96%",
        "destructive": "356 65.1% 49.4%",
        "destructive-foreground": "0 0% 100%",
        "success": "139.3 69.8% 40.2%",
        "success-foreground": "225.9 36.2% 9.2%",
        "warning": "42.4 100% 45.5%",
        "warning-foreground": "225.9 36.2% 9.2%",
        "info": "201 67% 51%",
        "info-foreground": "225.9 36.2% 9.2%",
        "border": "218.6 10.8% 25.5%",
        "input": "218.6 10.8% 25.5%",
        "ring": "20.1 100% 56.1%",
        "sidebar-background": "225.9 36.2% 9.2%",
        "sidebar-foreground": "220 14% 96%",
        "sidebar-primary": "20.1 100% 56.1%",
        "sidebar-primary-foreground": "225.9 36.2% 9.2%",
        "sidebar-accent": "223.6 13.6% 15.9%",
        "sidebar-accent-foreground": "220 14% 96%",
        "sidebar-border": "223.6 13.6% 15.9%",
        "radius": "0.5rem",
        "font-sans": "\"SB Sans Display\", \"Inter\", system-ui, sans-serif"
      }
    }
  }
}
