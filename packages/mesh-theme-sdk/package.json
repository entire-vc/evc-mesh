{
  "name": "@entire-vc/mesh-theme-sdk",
  "version": "1.0.0",
  "description": "Types, data hooks and primitives for building Mesh themes.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./testing": "./testing/index.ts"
  },
  "files": ["dist", "testing", "cli", "schema", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/check-fixtures.mjs && node scripts/check-cli.mjs && node scripts/check-docs.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "vitest": ">=4",
    "@testing-library/react": ">=16",
    "@testing-library/user-event": ">=14",
    "axe-core": ">=4"
  },
  "peerDependenciesMeta": {
    "vitest": { "optional": true },
    "@testing-library/react": { "optional": true },
    "@testing-library/user-event": { "optional": true },
    "axe-core": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "typescript": "~7.0.2"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2"
  },
  "bin": { "mesh-theme": "./cli/mesh-theme.mjs" },
  "engines": { "node": ">=20.11" }
}
