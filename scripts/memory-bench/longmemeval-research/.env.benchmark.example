# LongMemEval-S research-harness environment. Copy to .env.benchmark in this
# directory and fill in real values — .env.benchmark itself is gitignored
# (see the repo-root .gitignore .env* pattern), never commit it.
#
# Names only below, no real values — see README.md for how to obtain each.

# --- Mesh (the memory backend under test) ---
# REQUIRED: agent key for the DEDICATED bench workspace. mesh_client.py refuses
# to run if this resolves to any workspace other than BENCH_WORKSPACE_SLUG below
# — the bench writes hundreds of synthetic memories and must never land in a
# real workspace's `memories` table.
MESH_AGENT_KEY=
MESH_API_URL=https://mesh.entire.host
# Must match the workspace MESH_AGENT_KEY resolves to (default: lme-bench)
BENCH_WORKSPACE_SLUG=lme-bench
# Optional: enable knowledge-graph-boosted recall for this run
RECALL_GRAPH_ENABLED=false

# --- Chat LLM (answer generation) ---
# REQUIRED: API key from your LLM provider (OpenAI, DeepSeek, OpenRouter, etc.)
LME_CHAT_API_KEY=
LME_CHAT_BASE_URL=https://api.openai.com/v1
LME_CHAT_MODEL=gpt-4o-mini

# --- Judge LLM (evaluation step) ---
# API key (sk-...), NOT the model name. Leave empty to reuse LME_CHAT_API_KEY.
LME_JUDGE_API_KEY=
LME_JUDGE_BASE_URL=https://api.openai.com/v1
# Recommended: gpt-4o for paper-comparable scores (what both committed result
# files were judged with — see ADR-temporal-reasoning-fix.md)
LME_JUDGE_MODEL=gpt-4o

# --- Retrieval tuning ---
LME_RETRIEVE_TOP_K=10
