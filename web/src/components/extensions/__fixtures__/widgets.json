{
  "schema": 1,
  "id": "widgets-sample",
  "name": "Widgets sample",
  "version": "1.0.0",
  "kind": "plugin",
  "runtime": "builtin",
  "mesh_api": ">=1 <2",
  "publisher": "entire-vc",
  "levels": {
    "instance": true,
    "workspace": true,
    "project": false
  },
  "settings": {
    "instance": {
      "type": "object",
      "properties": {
        "image_registry": {
          "type": "string",
          "title": "Image registry",
          "format": "uri"
        }
      }
    },
    "workspace": {
      "type": "object",
      "properties": {
        "default_agent": {
          "type": "string",
          "title": "Default agent",
          "x-widget": "agent-picker"
        },
        "default_project": {
          "type": "string",
          "title": "Default project",
          "x-widget": "project-picker"
        },
        "allowed_images": {
          "type": "array",
          "title": "Allowed images",
          "x-widget": "list",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "policy": {
          "type": "string",
          "title": "Run policy",
          "x-widget": "textarea",
          "maxLength": 500,
          "x-help": "Free text for administrators"
        },
        "limits": {
          "type": "object",
          "x-widget": "group",
          "title": "Limits",
          "properties": {
            "max_parallel": {
              "type": "integer",
              "title": "Parallel runs",
              "minimum": 1,
              "maximum": 50,
              "default": 4
            },
            "run_token": {
              "type": "string",
              "title": "Run token",
              "x-secret": true
            }
          }
        }
      }
    }
  }
}
