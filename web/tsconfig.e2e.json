{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["e2e", "board-e2e/*.ts", "e2e-tabs/*.ts", "e2e-chat/**/*.ts", "e2e-partner/**/*.ts", "e2e-appearance/*.ts", "e2e-connect/*.ts", "e2e-runner/*.ts", "e2e-ext-diag/*.ts", "e2e-ext-frame/*.ts", "e2e-reference-ext/*.ts", "playwright.config.ts", "playwright.tabs.config.ts", "perf/*.ts"]
}
